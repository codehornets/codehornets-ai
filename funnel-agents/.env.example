# API Gateway
API_GATEWAY_PORT=3000
CORS_ORIGINS=http://localhost:4200,http://localhost:3000

# Auth Service
AUTH_SERVICE_HOST=localhost
AUTH_SERVICE_PORT=3001
AUTH_SERVICE_TCP_PORT=3011

# CRM Service
CRM_SERVICE_HOST=localhost
CRM_SERVICE_PORT=3002

# Campaigns Service
CAMPAIGNS_SERVICE_HOST=localhost
CAMPAIGNS_SERVICE_PORT=3003

# Content Service
CONTENT_SERVICE_HOST=localhost
CONTENT_SERVICE_PORT=3004

# Agents Service
AGENTS_SERVICE_HOST=localhost
AGENTS_SERVICE_PORT=3005

# Tasks Service
TASKS_SERVICE_HOST=localhost
TASKS_SERVICE_PORT=3006

# Automations Service
AUTOMATIONS_SERVICE_HOST=localhost
AUTOMATIONS_SERVICE_PORT=3007

# Reports Service
REPORTS_SERVICE_HOST=localhost
REPORTS_SERVICE_PORT=3008

# Worker Runner
WORKER_RUNNER_HOST=localhost
WORKER_RUNNER_PORT=3009

# Scheduler
SCHEDULER_HOST=localhost
SCHEDULER_PORT=3010

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/funnel_agents

# Auth Service Database
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=funnelagents_auth
DB_SYNCHRONIZE=true
DB_LOGGING=false

# Redis (for caching, queues, and distributed rate limiting)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379
# Note: REDIS_URL is optional and takes precedence over REDIS_HOST/PORT
# For distributed rate limiting across multiple service instances, ensure Redis is configured

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRATION=15m
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-this-in-production
JWT_REFRESH_EXPIRATION=7d
