{
  "name": "campaigns-service",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/campaigns-service/src",
  "projectType": "application",
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/apps/campaigns-service",
        "main": "apps/campaigns-service/src/main.ts",
        "tsConfig": "apps/campaigns-service/tsconfig.app.json",
        "assets": ["apps/campaigns-service/src/assets"]
      }
    },
    "serve": {
      "executor": "@nx/js:node",
      "options": {
        "buildTarget": "campaigns-service:build",
        "watch": true,
        "inspect": "inspect:9232"
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/apps/campaigns-service"],
      "options": {
        "jestConfig": "apps/campaigns-service/jest.config.ts",
        "passWithNoTests": true
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "options": {
        "lintFilePatterns": ["apps/campaigns-service/**/*.ts"]
      }
    }
  },
  "tags": ["scope:campaigns", "type:microservice"]
}
