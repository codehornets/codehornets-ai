{
  "name": "Lead Qualification Workflow",
  "description": "Automatically qualifies leads, sends to appropriate agent, and notifies sales team",
  "status": "active",
  "trigger_type": "webhook",
  "trigger_config": {
    "webhookPath": "lead-created",
    "webhookSecret": "my-secret-key"
  },
  "nodes": [
    {
      "id": "trigger-1",
      "type": "trigger",
      "position": { "x": 100, "y": 100 },
      "data": {
        "triggerType": "webhook",
        "webhookPath": "lead-created"
      }
    },
    {
      "id": "agent-qualify",
      "type": "agent",
      "position": { "x": 300, "y": 100 },
      "data": {
        "agentName": "lead-qualification-agent",
        "input": {
          "leadData": "${trigger.payload}",
          "context": "Evaluate lead quality based on company size, industry, and budget"
        },
        "parameters": {
          "temperature": 0.3,
          "maxTokens": 500
        },
        "timeout": 30000
      }
    },
    {
      "id": "condition-score",
      "type": "condition",
      "position": { "x": 500, "y": 100 },
      "data": {
        "operator": ">=",
        "leftValue": "${node.agent-qualify.result.score}",
        "rightValue": 75,
        "description": "Check if lead score is high enough"
      }
    },
    {
      "id": "email-high-priority",
      "type": "email",
      "position": { "x": 700, "y": 50 },
      "data": {
        "to": "sales-team@company.com",
        "subject": "High-Priority Lead: ${trigger.payload.company}",
        "template": "high-priority-lead",
        "templateData": {
          "leadName": "${trigger.payload.name}",
          "company": "${trigger.payload.company}",
          "score": "${node.agent-qualify.result.score}",
          "recommendation": "${node.agent-qualify.result.recommendation}",
          "urgency": "high"
        }
      }
    },
    {
      "id": "webhook-crm-high",
      "type": "webhook",
      "position": { "x": 900, "y": 50 },
      "data": {
        "url": "https://api.crm.com/leads",
        "method": "POST",
        "auth": {
          "type": "bearer",
          "token": "${env.CRM_API_TOKEN}"
        },
        "body": {
          "name": "${trigger.payload.name}",
          "email": "${trigger.payload.email}",
          "company": "${trigger.payload.company}",
          "score": "${node.agent-qualify.result.score}",
          "priority": "high",
          "assignee": "sales-team"
        },
        "timeout": 10000
      }
    },
    {
      "id": "delay-nurture",
      "type": "delay",
      "position": { "x": 700, "y": 150 },
      "data": {
        "duration": 2,
        "unit": "hours",
        "description": "Wait before sending nurture email"
      }
    },
    {
      "id": "email-nurture",
      "type": "email",
      "position": { "x": 900, "y": 150 },
      "data": {
        "to": "${trigger.payload.email}",
        "subject": "Welcome to Our Platform",
        "template": "nurture-email",
        "templateData": {
          "name": "${trigger.payload.name}",
          "company": "${trigger.payload.company}",
          "resources": [
            "Getting Started Guide",
            "Case Studies",
            "Product Demo"
          ]
        }
      }
    },
    {
      "id": "webhook-crm-low",
      "type": "webhook",
      "position": { "x": 1100, "y": 150 },
      "data": {
        "url": "https://api.crm.com/leads",
        "method": "POST",
        "auth": {
          "type": "bearer",
          "token": "${env.CRM_API_TOKEN}"
        },
        "body": {
          "name": "${trigger.payload.name}",
          "email": "${trigger.payload.email}",
          "company": "${trigger.payload.company}",
          "score": "${node.agent-qualify.result.score}",
          "priority": "normal",
          "assignee": "nurture-team"
        }
      }
    }
  ],
  "edges": [
    {
      "id": "e1",
      "source": "trigger-1",
      "target": "agent-qualify"
    },
    {
      "id": "e2",
      "source": "agent-qualify",
      "target": "condition-score"
    },
    {
      "id": "e3",
      "source": "condition-score",
      "target": "email-high-priority",
      "condition": "true"
    },
    {
      "id": "e4",
      "source": "email-high-priority",
      "target": "webhook-crm-high"
    },
    {
      "id": "e5",
      "source": "condition-score",
      "target": "delay-nurture",
      "condition": "false"
    },
    {
      "id": "e6",
      "source": "delay-nurture",
      "target": "email-nurture"
    },
    {
      "id": "e7",
      "source": "email-nurture",
      "target": "webhook-crm-low"
    }
  ]
}
