{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "../../dist/out-tsc",
    "module": "commonjs",
    "types": [
      "node"
    ],
    "emitDecoratorMetadata": true,
    "target": "ES2021",
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "noEmit": true
  },
  "exclude": [
    "jest.config.ts",
    "src/**/*.spec.ts",
    "src/**/*.test.ts",
    "../../node_modules"
  ],
  "include": [
    "src/**/*.ts"
  ]
}
