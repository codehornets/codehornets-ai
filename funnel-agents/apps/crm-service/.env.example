# CRM Service Environment Variables

# Service Configuration
NODE_ENV=development
CRM_SERVICE_HOST=0.0.0.0
CRM_SERVICE_PORT=3002

# Database Configuration
DATABASE_URL=postgresql://funnelagents:funnelagents_dev@localhost:5432/funnel_agents_crm

# Optional: Database connection details (alternative to DATABASE_URL)
# DB_HOST=localhost
# DB_PORT=5432
# DB_USERNAME=funnelagents
# DB_PASSWORD=funnelagents_dev
# DB_DATABASE=funnel_agents_crm

# Logging
LOG_LEVEL=debug

# Feature Flags (optional)
ENABLE_SYNC=true
ENABLE_LOGGING=true
