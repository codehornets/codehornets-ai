# Integration Test Environment Configuration
# Copy to .env.test and customize if needed

# PostgreSQL Test Database
TEST_POSTGRES_HOST=localhost
TEST_POSTGRES_PORT=5433
TEST_POSTGRES_DB=funnel_agents_test
TEST_POSTGRES_USER=funnel_agents
TEST_POSTGRES_PASSWORD=secret

# Redis Test Instance
TEST_REDIS_HOST=localhost
TEST_REDIS_PORT=6380

# Service TCP Ports
TEST_AUTH_SERVICE_HOST=localhost
TEST_AUTH_SERVICE_TCP_PORT=3011

TEST_CRM_SERVICE_HOST=localhost
TEST_CRM_SERVICE_TCP_PORT=3012

TEST_AGENTS_SERVICE_HOST=localhost
TEST_AGENTS_SERVICE_TCP_PORT=3015

# Python Agent API
TEST_PYTHON_AGENT_API_URL=http://localhost:8000

# Test Timeouts (milliseconds)
TEST_DEFAULT_TIMEOUT=60000
TEST_QUEUE_TIMEOUT=90000
TEST_DB_TIMEOUT=45000
