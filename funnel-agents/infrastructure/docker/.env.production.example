# =============================================================================
# FunnelAgents - Production Environment Configuration
# =============================================================================
# IMPORTANT: Copy this file to .env.production and update all values
# Never commit the actual .env.production file to version control

# =============================================================================
# Application Environment
# =============================================================================
NODE_ENV=production
APP_TIMEZONE=UTC
IMAGE_TAG=latest

# =============================================================================
# Domain Configuration
# =============================================================================
DOMAIN=funnelagents.example.com
N8N_HOST=n8n.funnelagents.example.com

# =============================================================================
# Database Configuration (PostgreSQL)
# =============================================================================
POSTGRES_DB=funnel_agents_prod
POSTGRES_USER=funnel_agents_prod
# IMPORTANT: Generate strong password and store in secrets/postgres_password.txt
# Use: openssl rand -base64 32

# Full DATABASE_URL (store in secrets/database_url.txt)
# Format: postgresql://USER:PASSWORD@postgres:5432/DATABASE

# Database Connection Pool Configuration
DB_POOL_MAX=50
DB_POOL_MIN=10

# =============================================================================
# Redis Configuration
# =============================================================================
REDIS_HOST=redis
REDIS_PORT=6379
# IMPORTANT: Generate strong password
# Use: openssl rand -base64 32
REDIS_PASSWORD=CHANGE_THIS_TO_SECURE_REDIS_PASSWORD

# =============================================================================
# JWT Authentication
# =============================================================================
# IMPORTANT: Generate strong secret and store in secrets/jwt_secret.txt
# Use: openssl rand -base64 64
JWT_EXPIRATION=1d

# =============================================================================
# n8n Workflow Automation
# =============================================================================
N8N_DB_DATABASE=funnel_agents_n8n_prod
N8N_PORT=5678
N8N_PROTOCOL=https
N8N_REDIS_DB=2

# IMPORTANT: Generate strong encryption key and store in secrets/n8n_encryption_key.txt
# Use: openssl rand -base64 32

# =============================================================================
# Email Configuration (Production SMTP)
# =============================================================================
MAIL_MAILER=smtp
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=noreply@funnelagents.example.com
MAIL_PASSWORD=CHANGE_THIS_TO_SMTP_PASSWORD
MAIL_FROM_ADDRESS=noreply@funnelagents.example.com
MAIL_FROM_NAME=FunnelAgents
MAIL_ENCRYPTION=tls

# =============================================================================
# Monitoring & Observability
# =============================================================================
LOG_LEVEL=info
ENABLE_APM=true
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# =============================================================================
# Security
# =============================================================================
# CORS Origins (comma-separated list)
CORS_ORIGINS=https://funnelagents.example.com,https://www.funnelagents.example.com

# Rate Limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=60000

# Session Configuration
SESSION_SECRET=CHANGE_THIS_TO_SECURE_SESSION_SECRET
SESSION_MAX_AGE=86400000

# =============================================================================
# Cloud Storage (Optional - for backups)
# =============================================================================
# AWS S3 Configuration
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=us-east-1
AWS_S3_BUCKET=funnelagents-backups

# Or Google Cloud Storage
GCS_PROJECT_ID=your_gcs_project
GCS_BUCKET=funnelagents-backups
GCS_KEYFILE=/path/to/keyfile.json

# =============================================================================
# External Services (Optional)
# =============================================================================
# OpenAI API
OPENAI_API_KEY=your_openai_api_key

# SendGrid
SENDGRID_API_KEY=your_sendgrid_api_key

# Stripe
STRIPE_API_KEY=your_stripe_api_key
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret

# =============================================================================
# Feature Flags
# =============================================================================
ENABLE_REGISTRATION=false
ENABLE_PUBLIC_API=true
ENABLE_WEBHOOKS=true
ENABLE_ANALYTICS=true

# =============================================================================
# Performance Tuning
# =============================================================================
NODE_OPTIONS=--max-old-space-size=2048
UV_THREADPOOL_SIZE=128

# Cache TTL (seconds)
CACHE_TTL=3600
CACHE_CHECK_PERIOD=600

# =============================================================================
# Backup Configuration
# =============================================================================
BACKUP_SCHEDULE=@daily
BACKUP_KEEP_DAYS=7
BACKUP_KEEP_WEEKS=4
BACKUP_KEEP_MONTHS=6
