# =============================================================================
# FunnelAgents - Environment Configuration
# =============================================================================

# Application Environment
NODE_ENV=development
APP_TIMEZONE=America/New_York

# =============================================================================
# Database Configuration (PostgreSQL)
# =============================================================================
POSTGRES_DB=funnel_agents
POSTGRES_USER=funnel_agents
POSTGRES_PASSWORD=secret
POSTGRES_PORT=5432

# Full DATABASE_URL (constructed from above)
DATABASE_URL=postgresql://funnel_agents:secret@localhost:5432/funnel_agents

# =============================================================================
# Redis Configuration
# NOTE: Using 6380 to avoid conflict with existing Redis on 6379
# =============================================================================
REDIS_HOST=localhost
REDIS_PORT=6380

# =============================================================================
# JWT Authentication
# =============================================================================
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRATION=1d

# =============================================================================
# API Gateway
# =============================================================================
API_GATEWAY_PORT=3000
CORS_ORIGINS=http://localhost:4200,http://localhost:3000

# =============================================================================
# Microservices Ports
# =============================================================================
AUTH_SERVICE_HOST=localhost
AUTH_SERVICE_PORT=3001

CRM_SERVICE_HOST=localhost
CRM_SERVICE_PORT=3002

CAMPAIGNS_SERVICE_HOST=localhost
CAMPAIGNS_SERVICE_PORT=3003

CONTENT_SERVICE_HOST=localhost
CONTENT_SERVICE_PORT=3004

AGENTS_SERVICE_HOST=localhost
AGENTS_SERVICE_PORT=3005

TASKS_SERVICE_HOST=localhost
TASKS_SERVICE_PORT=3006

AUTOMATIONS_SERVICE_HOST=localhost
AUTOMATIONS_SERVICE_PORT=3007

REPORTS_SERVICE_HOST=localhost
REPORTS_SERVICE_PORT=3008

WORKER_RUNNER_HOST=localhost
WORKER_RUNNER_PORT=3009

SCHEDULER_HOST=localhost
SCHEDULER_PORT=3010

# =============================================================================
# Frontend (Web UI)
# =============================================================================
WEB_UI_PORT=4200
VITE_API_URL=http://localhost:3000

# =============================================================================
# n8n Workflow Automation (Agent Orchestration)
# =============================================================================
N8N_DB_DATABASE=funnel_agents_n8n
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
N8N_WEBHOOK_URL=http://localhost:5678/webhook
N8N_EXECUTIONS_MODE=queue
N8N_REDIS_DB=2

# n8n Authentication
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=changeme

# n8n Security (IMPORTANT: Change in production!)
N8N_ENCRYPTION_KEY=change-this-to-a-secure-random-key

# n8n Logging & Diagnostics
N8N_DIAGNOSTICS_ENABLED=false
N8N_PERSONALIZATION_ENABLED=false
N8N_LOG_LEVEL=info
N8N_LOG_OUTPUT=console,file

# =============================================================================
# Development Tools (Optional)
# =============================================================================
REDIS_COMMANDER_PORT=8081
PGADMIN_PORT=5050
PGADMIN_EMAIL=admin@funnelagents.com
PGADMIN_PASSWORD=admin
MAILHOG_SMTP_PORT=1025
MAILHOG_UI_PORT=8025

# =============================================================================
# Email Configuration (for notifications)
# =============================================================================
MAIL_MAILER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=noreply@funnelagents.com
MAIL_FROM_NAME=FunnelAgents
MAIL_ENCRYPTION=false
