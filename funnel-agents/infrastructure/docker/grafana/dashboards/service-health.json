{
  "dashboard": {
    "title": "FunnelAgents - Service Health Overview",
    "uid": "funnelagents-service-health",
    "timezone": "browser",
    "schemaVersion": 16,
    "version": 1,
    "refresh": "30s",
    "time": {
      "from": "now-1h",
      "to": "now"
    },
    "panels": [
      {
        "id": 1,
        "title": "Service Uptime",
        "type": "stat",
        "gridPos": {"h": 4, "w": 6, "x": 0, "y": 0},
        "targets": [{
          "expr": "up{job=~\".*-service\"}",
          "legendFormat": "{{ job }}",
          "refId": "A"
        }],
        "fieldConfig": {
          "defaults": {
            "mappings": [
              {"type": "value", "value": "0", "text": "DOWN"},
              {"type": "value", "value": "1", "text": "UP"}
            ],
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"value": 0, "color": "red"},
                {"value": 1, "color": "green"}
              ]
            }
          }
        }
      },
      {
        "id": 2,
        "title": "Request Rate (req/s)",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 4},
        "targets": [{
          "expr": "sum(rate(funnelagents_http_requests_total[5m])) by (service)",
          "legendFormat": "{{ service }}",
          "refId": "A"
        }]
      },
      {
        "id": 3,
        "title": "Error Rate (%)",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 4},
        "targets": [{
          "expr": "sum(rate(funnelagents_http_requests_total{status_code=~\"5..\"}[5m])) by (service) / sum(rate(funnelagents_http_requests_total[5m])) by (service) * 100",
          "legendFormat": "{{ service }}",
          "refId": "A"
        }],
        "yaxes": [
          {"format": "percent", "label": "Error Rate"},
          {"format": "short"}
        ]
      },
      {
        "id": 4,
        "title": "P95 Response Time (seconds)",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 12},
        "targets": [{
          "expr": "histogram_quantile(0.95, sum(rate(funnelagents_http_request_duration_seconds_bucket[5m])) by (service, le))",
          "legendFormat": "{{ service }}",
          "refId": "A"
        }]
      },
      {
        "id": 5,
        "title": "Active Database Connections",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 12},
        "targets": [{
          "expr": "funnelagents_db_connections_active",
          "legendFormat": "{{ service }}",
          "refId": "A"
        }]
      },
      {
        "id": 6,
        "title": "Memory Usage (MB)",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 20},
        "targets": [{
          "expr": "funnelagents_memory_heap_used_bytes / 1024 / 1024",
          "legendFormat": "{{ service }}",
          "refId": "A"
        }]
      },
      {
        "id": 7,
        "title": "CPU Usage (%)",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 20},
        "targets": [{
          "expr": "funnelagents_cpu_usage_percentage",
          "legendFormat": "{{ service }}",
          "refId": "A"
        }]
      }
    ]
  }
}
