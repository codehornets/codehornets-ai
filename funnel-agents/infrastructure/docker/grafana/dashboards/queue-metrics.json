{
  "dashboard": {
    "title": "FunnelAgents - Queue Metrics",
    "uid": "funnelagents-queue-metrics",
    "timezone": "browser",
    "schemaVersion": 16,
    "version": 1,
    "refresh": "30s",
    "time": {
      "from": "now-1h",
      "to": "now"
    },
    "panels": [
      {
        "id": 1,
        "title": "Jobs Waiting in Queue",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
        "targets": [{
          "expr": "funnelagents_queue_jobs_waiting",
          "legendFormat": "{{ queue }}",
          "refId": "A"
        }]
      },
      {
        "id": 2,
        "title": "Active Jobs",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
        "targets": [{
          "expr": "funnelagents_queue_jobs_active",
          "legendFormat": "{{ queue }}",
          "refId": "A"
        }]
      },
      {
        "id": 3,
        "title": "Job Processing Rate",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
        "targets": [{
          "expr": "sum(rate(funnelagents_queue_jobs_total[5m])) by (queue, status)",
          "legendFormat": "{{ queue }} - {{ status }}",
          "refId": "A"
        }]
      },
      {
        "id": 4,
        "title": "Job Failure Rate (%)",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
        "targets": [{
          "expr": "sum(rate(funnelagents_queue_jobs_failed_total[5m])) by (queue) / sum(rate(funnelagents_queue_jobs_total[5m])) by (queue) * 100",
          "legendFormat": "{{ queue }}",
          "refId": "A"
        }],
        "yaxes": [
          {"format": "percent", "label": "Failure Rate"},
          {"format": "short"}
        ]
      },
      {
        "id": 5,
        "title": "Job Processing Duration (P95)",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 16},
        "targets": [{
          "expr": "histogram_quantile(0.95, sum(rate(funnelagents_queue_job_duration_seconds_bucket[5m])) by (queue, le))",
          "legendFormat": "{{ queue }}",
          "refId": "A"
        }]
      },
      {
        "id": 6,
        "title": "Jobs by Type",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 16},
        "targets": [{
          "expr": "sum(rate(funnelagents_queue_jobs_total[5m])) by (job_type)",
          "legendFormat": "{{ job_type }}",
          "refId": "A"
        }]
      },
      {
        "id": 7,
        "title": "Queue Backlog Alert",
        "type": "stat",
        "gridPos": {"h": 4, "w": 6, "x": 0, "y": 24},
        "targets": [{
          "expr": "sum(funnelagents_queue_jobs_waiting) by (queue)",
          "legendFormat": "{{ queue }}",
          "refId": "A"
        }],
        "fieldConfig": {
          "defaults": {
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"value": 0, "color": "green"},
                {"value": 500, "color": "yellow"},
                {"value": 1000, "color": "red"}
              ]
            }
          }
        }
      },
      {
        "id": 8,
        "title": "Failed Jobs per Minute",
        "type": "stat",
        "gridPos": {"h": 4, "w": 6, "x": 6, "y": 24},
        "targets": [{
          "expr": "sum(rate(funnelagents_queue_jobs_failed_total[1m])) * 60",
          "refId": "A"
        }],
        "fieldConfig": {
          "defaults": {
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"value": 0, "color": "green"},
                {"value": 5, "color": "yellow"},
                {"value": 20, "color": "red"}
              ]
            }
          }
        }
      }
    ]
  }
}
