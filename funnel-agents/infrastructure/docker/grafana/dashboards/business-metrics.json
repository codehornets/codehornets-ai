{
  "dashboard": {
    "title": "FunnelAgents - Business Metrics",
    "uid": "funnelagents-business-metrics",
    "timezone": "browser",
    "schemaVersion": 16,
    "version": 1,
    "refresh": "1m",
    "time": {
      "from": "now-24h",
      "to": "now"
    },
    "panels": [
      {
        "id": 1,
        "title": "Active Agents",
        "type": "stat",
        "gridPos": {"h": 4, "w": 6, "x": 0, "y": 0},
        "targets": [{
          "expr": "funnelagents_agents_active_count",
          "refId": "A"
        }],
        "fieldConfig": {
          "defaults": {
            "color": {"mode": "thresholds"},
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"value": 0, "color": "red"},
                {"value": 1, "color": "green"}
              ]
            }
          }
        }
      },
      {
        "id": 2,
        "title": "Pending Tasks",
        "type": "stat",
        "gridPos": {"h": 4, "w": 6, "x": 6, "y": 0},
        "targets": [{
          "expr": "funnelagents_tasks_pending_count",
          "refId": "A"
        }],
        "fieldConfig": {
          "defaults": {
            "color": {"mode": "thresholds"},
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"value": 0, "color": "green"},
                {"value": 100, "color": "yellow"},
                {"value": 500, "color": "red"}
              ]
            }
          }
        }
      },
      {
        "id": 3,
        "title": "Agent Executions (24h)",
        "type": "stat",
        "gridPos": {"h": 4, "w": 6, "x": 12, "y": 0},
        "targets": [{
          "expr": "sum(increase(funnelagents_agents_executions_total[24h]))",
          "refId": "A"
        }]
      },
      {
        "id": 4,
        "title": "Tasks Completed (24h)",
        "type": "stat",
        "gridPos": {"h": 4, "w": 6, "x": 18, "y": 0},
        "targets": [{
          "expr": "sum(increase(funnelagents_tasks_completed_total[24h]))",
          "refId": "A"
        }]
      },
      {
        "id": 5,
        "title": "Agent Execution Rate",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 4},
        "targets": [{
          "expr": "sum(rate(funnelagents_agents_executions_total[5m])) by (agent_type)",
          "legendFormat": "{{ agent_type }}",
          "refId": "A"
        }]
      },
      {
        "id": 6,
        "title": "Agent Success vs Error Rate",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 4},
        "targets": [
          {
            "expr": "sum(rate(funnelagents_agents_executions_total{status=\"success\"}[5m])) by (agent_type)",
            "legendFormat": "{{ agent_type }} Success",
            "refId": "A"
          },
          {
            "expr": "sum(rate(funnelagents_agents_executions_total{status=\"error\"}[5m])) by (agent_type)",
            "legendFormat": "{{ agent_type }} Error",
            "refId": "B"
          }
        ]
      },
      {
        "id": 7,
        "title": "Agent Execution Duration (P95)",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 12},
        "targets": [{
          "expr": "histogram_quantile(0.95, sum(rate(funnelagents_agents_execution_duration_seconds_bucket[5m])) by (agent_type, le))",
          "legendFormat": "{{ agent_type }}",
          "refId": "A"
        }]
      },
      {
        "id": 8,
        "title": "Task Creation vs Completion Rate",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 12},
        "targets": [
          {
            "expr": "sum(rate(funnelagents_tasks_created_total[5m]))",
            "legendFormat": "Created",
            "refId": "A"
          },
          {
            "expr": "sum(rate(funnelagents_tasks_completed_total[5m]))",
            "legendFormat": "Completed",
            "refId": "B"
          },
          {
            "expr": "sum(rate(funnelagents_tasks_failed_total[5m]))",
            "legendFormat": "Failed",
            "refId": "C"
          }
        ]
      },
      {
        "id": 9,
        "title": "Workflow Executions",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 20},
        "targets": [{
          "expr": "sum(rate(funnelagents_workflow_executions_total[5m])) by (workflow_type, status)",
          "legendFormat": "{{ workflow_type }} - {{ status }}",
          "refId": "A"
        }]
      },
      {
        "id": 10,
        "title": "Workflow Duration (P95)",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 20},
        "targets": [{
          "expr": "histogram_quantile(0.95, sum(rate(funnelagents_workflow_execution_duration_seconds_bucket[5m])) by (workflow_type, le))",
          "legendFormat": "{{ workflow_type }}",
          "refId": "A"
        }]
      },
      {
        "id": 11,
        "title": "Rate Limit Violations",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 28},
        "targets": [{
          "expr": "sum(rate(funnelagents_api_rate_limit_exceeded_total[5m])) by (endpoint)",
          "legendFormat": "{{ endpoint }}",
          "refId": "A"
        }]
      },
      {
        "id": 12,
        "title": "Cache Hit Rate",
        "type": "gauge",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 28},
        "targets": [{
          "expr": "sum(rate(funnelagents_cache_hits_total[5m])) / (sum(rate(funnelagents_cache_hits_total[5m])) + sum(rate(funnelagents_cache_misses_total[5m]))) * 100",
          "refId": "A"
        }],
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "min": 0,
            "max": 100,
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"value": 0, "color": "red"},
                {"value": 50, "color": "yellow"},
                {"value": 80, "color": "green"}
              ]
            }
          }
        }
      }
    ]
  }
}
