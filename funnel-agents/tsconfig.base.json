{
  "compileOnSave": false,
  "compilerOptions": {
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "node",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "ES2022",
    "module": "commonjs",
    "lib": ["ES2022"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "strict": true,
    "strictNullChecks": true,
    "strictPropertyInitialization": false,
    "noImplicitAny": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "forceConsistentCasingInFileNames": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "incremental": true,
    "baseUrl": ".",
    "paths": {
      "@funnelagents/agents": ["libs/agents/src/index.ts"],
      "@funnelagents/agents/*": ["libs/agents/src/*"],
      "@funnelagents/analytics": ["libs/analytics/src/index.ts"],
      "@funnelagents/analytics/*": ["libs/analytics/src/*"],
      "@funnelagents/application": ["libs/application/src/index.ts"],
      "@funnelagents/application/*": ["libs/application/src/*"],
      "@funnelagents/auth": ["libs/auth/src/index.ts"],
      "@funnelagents/auth/*": ["libs/auth/src/*"],
      "@funnelagents/common": ["libs/common/src/index.ts"],
      "@funnelagents/common/*": ["libs/common/src/*"],
      "@funnelagents/core": ["libs/core/src/index.ts"],
      "@funnelagents/core/*": ["libs/core/src/*"],
      "@funnelagents/database": ["libs/database/src/index.ts"],
      "@funnelagents/database/*": ["libs/database/src/*"],
      "@funnelagents/domain": ["libs/domain/src/index.ts"],
      "@funnelagents/domain/*": ["libs/domain/src/*"],
      "@funnelagents/infrastructure": ["libs/infrastructure/src/index.ts"],
      "@funnelagents/infrastructure/*": ["libs/infrastructure/src/*"],
      "@funnelagents/integrations": ["libs/integrations/src/index.ts"],
      "@funnelagents/integrations/*": ["libs/integrations/src/*"],
      "@funnelagents/interfaces": ["libs/interfaces/src/index.ts"],
      "@funnelagents/interfaces/*": ["libs/interfaces/src/*"],
      "@funnelagents/messaging": ["libs/messaging/src/index.ts"],
      "@funnelagents/messaging/*": ["libs/messaging/src/*"],
      "@funnelagents/orchestration": ["libs/orchestration/src/index.ts"],
      "@funnelagents/orchestration/*": ["libs/orchestration/src/*"],
      "@funnelagents/shared": ["libs/shared/src/index.ts"],
      "@funnelagents/shared/*": ["libs/shared/src/*"],
      "@funnelagents/testing": ["libs/testing/src/index.ts"],
      "@funnelagents/testing/*": ["libs/testing/src/*"]
    }
  },
  "exclude": ["node_modules", "tmp", "dist", "coverage"]
}
