{
  "name": "@funnelagents/source",
  "version": "0.0.1",
  "license": "MIT",
  "private": true,
  "description": "FunnelAgents - AI-powered multi-agent orchestration platform",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "scripts": {
    "build": "nx run-many --target=build --all",
    "build:affected": "nx affected --target=build",
    "build:prod": "nx run-many --target=build --all --configuration=production",
    "serve": "nx serve",
    "serve:all": "nx run-many --target=serve --all --parallel",
    "start": "nx serve",
    "test": "nx run-many --target=test --all",
    "test:unit": "nx run-many --target=test --all --exclude=*-e2e",
    "test:e2e": "nx run api-gateway:e2e",
    "test:e2e:all": "nx run-many --target=e2e --all",
    "test:watch": "nx run-many --target=test --all --watch",
    "test:affected": "nx affected --target=test",
    "test:cov": "nx run-many --target=test --all --coverage",
    "test:coverage": "nx run-many --target=test --all --coverage",
    "test:ci": "nx run-many --target=test --all --configuration=ci",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:services": "nx run-many --target=test --projects=auth-service,crm-service,agents-service,tasks-service,campaigns-service,automations-service,reports-service",
    "test:integration": "jest --config=jest.integration.config.js --runInBand",
    "test:integration:watch": "jest --config=jest.integration.config.js --runInBand --watch",
    "lint": "nx run-many --target=lint --all",
    "lint:affected": "nx affected --target=lint",
    "lint:fix": "nx run-many --target=lint --all --fix",
    "format": "nx format:write",
    "format:check": "nx format:check",
    "e2e": "nx run-many --target=e2e --all",
    "e2e:affected": "nx affected --target=e2e",
    "graph": "nx graph",
    "affected:graph": "nx affected:graph",
    "clean": "nx reset && rimraf dist node_modules/.cache",
    "clean:all": "nx reset && rimraf dist node_modules",
    "dep-graph": "nx dep-graph",
    "migrate": "nx migrate latest",
    "migrate:run": "nx migrate --run-migrations",
    "workspace-generator": "nx workspace-generator",
    "generate": "nx generate",
    "g": "nx generate",
    "prepare": "husky install || true",
    "precommit": "lint-staged"
  },
  "workspaces": [
    "apps/!(web-ui)",
    "libs/*"
  ],
  "dependencies": {
    "@nestjs/axios": "^4.0.1",
    "@nestjs/bullmq": "^11.0.4",
    "@nestjs/common": "^10.3.0",
    "@nestjs/config": "^3.1.1",
    "@nestjs/core": "^10.3.0",
    "@nestjs/cqrs": "^10.2.7",
    "@nestjs/event-emitter": "^3.0.1",
    "@nestjs/jwt": "^11.0.1",
    "@nestjs/mapped-types": "^2.1.0",
    "@nestjs/microservices": "^10.4.20",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^10.3.0",
    "@nestjs/schedule": "^4.1.2",
    "@nestjs/swagger": "^7.4.2",
    "@nestjs/throttler": "^5.2.0",
    "@nestjs/typeorm": "^11.0.0",
    "@willsoto/nestjs-prometheus": "^6.0.2",
    "axios": "^1.6.5",
    "bcrypt": "^6.0.0",
    "bullmq": "^5.64.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cls-hooked": "^4.2.2",
    "cookie-parser": "^1.4.7",
    "cron": "^3.1.7",
    "cron-parser": "^4.9.0",
    "csurf": "^1.11.0",
    "helmet": "^8.1.0",
    "ioredis": "^5.3.2",
    "joi": "^18.0.2",
    "multer": "^2.0.2",
    "nestjs-pino": "^4.5.0",
    "nodemailer": "^6.9.8",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.16.3",
    "pino": "^10.1.0",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.1.2",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.1",
    "rxjs": "^7.8.1",
    "tslib": "^2.6.2",
    "typeorm": "^0.3.27",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@nestjs/schematics": "^10.1.0",
    "@nestjs/testing": "^10.3.0",
    "@nx/devkit": "^19.0.0",
    "@nx/eslint": "^19.0.0",
    "@nx/eslint-plugin": "^19.0.0",
    "@nx/jest": "^19.0.0",
    "@nx/js": "^19.0.0",
    "@nx/nest": "^19.0.0",
    "@nx/node": "^19.0.0",
    "@nx/webpack": "^22.1.1",
    "@nx/workspace": "^19.0.0",
    "@swc-node/register": "^1.11.1",
    "@swc/core": "^1.15.3",
    "@swc/helpers": "^0.5.6",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cron": "^2.4.0",
    "@types/diff": "^7.0.2",
    "@types/dompurify": "^3.0.5",
    "@types/express": "^5.0.5",
    "@types/jest": "^29.5.12",
    "@types/multer": "^2.0.0",
    "@types/node": "^20.11.0",
    "@types/nodemailer": "^6.4.14",
    "@types/passport-jwt": "^4.0.1",
    "@types/pdfkit": "^0.17.3",
    "@types/supertest": "^6.0.2",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "husky": "^9.0.0",
    "jest": "^29.7.0",
    "jest-environment-node": "^29.7.0",
    "lint-staged": "^15.2.0",
    "nx": "^19.0.0",
    "prettier": "^3.2.0",
    "rimraf": "^5.0.5",
    "supertest": "^7.0.0",
    "swc-loader": "^0.2.6",
    "ts-jest": "^29.1.2",
    "ts-loader": "^9.5.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3",
    "webpack": "^5.103.0",
    "webpack-node-externals": "^3.0.0"
  },
  "lint-staged": {
    "*.{ts,js}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  }
}
